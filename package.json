{
  "name": "job-copilot",
  "description": "AI-assisted job search platform with a deterministic matching engine and an optional, swappable AI layer.",
  "author": "Jai Maheshwari",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaimaheshwari1706/job-copilot.git"
  },
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @job-copilot/web",
    "dev:api": "npm run dev -w @job-copilot/api",
    "dev:worker": "npm run dev -w @job-copilot/worker",
    "build:packages": "npm run build -w @job-copilot/shared -w @job-copilot/domain -w @job-copilot/ai -w @job-copilot/jobs -w @job-copilot/storage -w @job-copilot/db -w @job-copilot/queue",
    "build:apps": "npm run build -w @job-copilot/api -w @job-copilot/worker -w @job-copilot/web",
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true
  }
}
