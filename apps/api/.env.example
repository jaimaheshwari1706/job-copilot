NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/job-copilot
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Auth
JWT_ACCESS_SECRET=dev-only-change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Storage (local-disk provider)
SIGNED_URL_SECRET=dev-only-change-me-to-a-random-32-plus-character-secret
SIGNED_URL_TTL_SECONDS=300

# AI (Phase 8) - optional. Leave unset to run without AI features (routes
# will respond with a clear "not configured" message rather than faking output).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
